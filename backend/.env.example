# ========================================================
# Society Maintenance Tracker - Backend Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Overdue Complaint Config (in days)
OVERDUE_DAYS=3

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_society_maintenance_2026

# PostgreSQL Database Connection String
# Example Neon/Supabase/Render: postgresql://username:password@ep-sample.us-east-1.aws.neon.tech/society_db?sslmode=require
# If empty or not set, automatically uses local SQLite fallback for dev
DATABASE_URL=

# Cloudinary Storage Configuration (Optional - Local storage used if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration (Optional - Console/mock logger used if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Society Maintenance" <notifications@societymaintenance.com>
